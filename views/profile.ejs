<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HireAI | My Profile</title>
    <link rel="stylesheet" href="/css/user_dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="logo">
            <h2>HireAI</h2>
        </div>
        <div class="search-box">
            <input type="text" placeholder="Search Jobs...">
        </div>
        <div class="nav-right">
            <i class="fa-solid fa-bell"></i>
            <img src="/images/user.png" alt="User">
        </div>
    </header>

    <!-- CONTAINER -->
    <div class="container">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <ul>
                <li>
                    <a href="/user_dashboard">
                        <i class="fa-solid fa-house"></i>
                        Dashboard
                    </a>
                </li>
                <li class="active">
                    <a href="/user_dashboard/profile">
                        <i class="fa-solid fa-user"></i>
                        My Profile
                    </a>
                </li>
                <li>
                    <a href="/user_dashboard/resume">
                        <i class="fa-solid fa-file"></i>
                        Resume
                    </a>
                </li>
                <li>
                    <a href="/user_dashboard/jobs">
                        <i class="fa-solid fa-briefcase"></i>
                        Jobs
                    </a>
                </li>
                <li>
                    <a href="/user_dashboard/applications">
                        <i class="fa-solid fa-paper-plane"></i>
                        Applications
                    </a>
                </li>
                <li>
                    <a href="/user_dashboard/interviews">
                        <i class="fa-solid fa-calendar-days"></i>
                        Interviews
                    </a>
                </li>
                <li>
                    <a href="/user_dashboard/settings">
                        <i class="fa-solid fa-gear"></i>
                        Settings
                    </a>
                </li>
                <li>
                    <a href="/">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Logout
                    </a>
                </li>
            </ul>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <section class="profile-section">
                <h2>Personal Information</h2>
                <form action="/api/user/profile" method="POST" class="profile-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="full-name">Full Name</label>
                            <input type="text" id="full-name" name="fullName" value="Vijay Kumar" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" value="vijay@example.com" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone" name="phone" value="+91 9876543210">
                        </div>
                        <div class="form-group">
                            <label for="location">Location</label>
                            <input type="text" id="location" name="location" value="Bengaluru, India">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="title">Professional Title</label>
                        <input type="text" id="title" name="title" value="Full Stack Developer">
                    </div>

                    <div class="form-group">
                        <label for="bio">Short Bio</label>
                        <textarea id="bio" name="bio" rows="4">Passionate Full Stack Developer with 2+ years of experience building modern web applications using Node.js, React, and MongoDB.</textarea>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary">Save Profile</button>
                    </div>
                </form>
            </section>
        </main>

    </div>

</body>
</html>