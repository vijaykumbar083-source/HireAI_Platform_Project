<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Company Profile | HireAI</title>
    <link rel="stylesheet" href="/css/recruiter_dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

<div class="container">

    <!-- Sidebar -->
    <aside class="sidebar">
        <h2>HireAI</h2>
        <ul>
            <li>
                <a href="/recruiter_dashboard">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/post_job">
                    <i class="fa-solid fa-plus"></i>
                    Post Job
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/manage_jobs">
                    <i class="fa-solid fa-briefcase"></i>
                    Manage Jobs
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/view_applicants">
                    <i class="fa-solid fa-users"></i>
                    Applicants
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/interview_schedule">
                    <i class="fa-solid fa-calendar-days"></i>
                    Interviews
                </a>
            </li>
            <li class="active">
                <a href="/recruiter_dashboard/company_profile">
                    <i class="fa-solid fa-building"></i>
                    Company
                </a>
            </li>
            <li>
                <a href="/">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <!-- Navbar -->
        <header class="navbar">
            <h1>Company Profile</h1>
            <div class="profile">
                <img src="https://i.pravatar.cc/50" alt="Profile">
                <span>Recruiter</span>
            </div>
        </header>

        <!-- Company Settings Form -->
        <section class="form-section">
            <h2>Organization Details</h2>
            <form action="/api/company/update" method="POST" class="company-form">
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="company-name">Company Name</label>
                        <input type="text" id="company-name" name="name" value="HireAI Technologies" required>
                    </div>

                    <div class="form-group">
                        <label for="website">Website URL</label>
                        <input type="url" id="website" name="website" value="https://hireai.example.com">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="industry">Industry</label>
                        <input type="text" id="industry" name="industry" value="Software & Artificial Intelligence">
                    </div>

                    <div class="form-group">
                        <label for="company-size">Company Size</label>
                        <select id="company-size" name="size">
                            <option value="1-10">1 - 10 Employees</option>
                            <option value="11-50" selected>11 - 50 Employees</option>
                            <option value="51-200">51 - 200 Employees</option>
                            <option value="500+">500+ Employees</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="headquarters">Headquarters Address</label>
                    <input type="text" id="headquarters" name="headquarters" value="Bengaluru, Karnataka, India">
                </div>

                <div class="form-group">
                    <label for="about">About Company</label>
                    <textarea id="about" name="about" rows="5">HireAI is building next-generation recruitment workflows powered by intelligent automation and real-time candidate assessment tools.</textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">Save Changes</button>
                </div>

            </form>
        </section>

    </main>

</div>

</body>
</html>