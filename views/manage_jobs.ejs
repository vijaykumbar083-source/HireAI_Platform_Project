<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Jobs | HireAI</title>
    <link rel="stylesheet" href="/css/recruiter_dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

<div class="container">

    <!-- Sidebar -->
    <aside class="sidebar">
        <h2>HireAI</h2>
        <ul>
            <li>
                <a href="/recruiter_dashboard">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/post_job">
                    <i class="fa-solid fa-plus"></i>
                    Post Job
                </a>
            </li>
            <li class="active">
                <a href="/recruiter_dashboard/manage_jobs">
                    <i class="fa-solid fa-briefcase"></i>
                    Manage Jobs
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/view_applicants">
                    <i class="fa-solid fa-users"></i>
                    Applicants
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/interview_schedule">
                    <i class="fa-solid fa-calendar-days"></i>
                    Interviews
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/company_profile">
                    <i class="fa-solid fa-building"></i>
                    Company
                </a>
            </li>
            <li>
                <a href="/">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <!-- Navbar -->
        <header class="navbar">
            <h1>Manage Jobs</h1>
            <div class="profile">
                <img src="https://i.pravatar.cc/50" alt="Profile">
                <span>Recruiter</span>
            </div>
        </header>

        <!-- Manage Jobs Table -->
        <section class="table-section">
            <div class="section-header">
                <h2>Active & Closed Postings</h2>
                <button class="btn-primary" onclick="location.href='/recruiter_dashboard/post_job'">
                    <i class="fa-solid fa-plus"></i> Post New Job
                </button>
            </div>

            <table>

    <thead>

        <tr>
            <th>Job Title</th>
            <th>Company</th>
            <th>Job Type</th>
            <th>Location</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>

    </thead>

    <tbody>

        <% jobs.forEach(job => { %>

        <tr>

            <td><%= job.title %></td>

            <td><%= job.company %></td>

            <td><%= job.jobType %></td>

            <td><%= job.location %></td>

            <td><%= job.salary %></td>

            <td>

               <a href="/recruiter_dashboard/edit_job/<%= job._id %>"
                style="background-color: blue; color: white; padding: 8px 12px; text-decoration: none; border-radius: 5px;">
                    Edit
                </a>

|

                <a href="/recruiter_dashboard/delete_job/<%= job._id %>"
                style="background-color: red; color: white; padding: 8px 12px; text-decoration: none; border-radius: 5px;">
                    Delete
                </a>                

            </td>

        </tr>

        <% }) %>

    </tbody>

</table>
        </section>

    </main>

</div>

</body>
</html>