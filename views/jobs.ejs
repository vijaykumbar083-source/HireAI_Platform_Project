<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HireAI | Jobs</title>

    <link rel="stylesheet" href="/css/user_dashboard.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <header class="navbar">

        <div class="logo">
            <h2>HireAI</h2>
        </div>

        <div class="search-box">
            <input type="text" placeholder="Search Jobs...">
        </div>

        <div class="nav-right">
            <i class="fa-solid fa-bell"></i>
            <img src="/images/user.png" alt="User">
        </div>

    </header>

    <!-- ================= CONTAINER ================= -->
    <div class="container">

        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar">

            <ul>

                <li>
                    <a href="/user_dashboard">
                        <i class="fa-solid fa-house"></i>
                        Dashboard
                    </a>
                </li>

                <li>
                    <a href="/user_dashboard/profile">
                        <i class="fa-solid fa-user"></i>
                        My Profile
                    </a>
                </li>

                <li>
                    <a href="/user_dashboard/resume">
                        <i class="fa-solid fa-file"></i>
                        Resume
                    </a>
                </li>

                <li class="active">
                    <a href="/user_dashboard/jobs">
                        <i class="fa-solid fa-briefcase"></i>
                        Jobs
                    </a>
                </li>

                <li>
                    <a href="/user_dashboard/applications">
                        <i class="fa-solid fa-paper-plane"></i>
                        Applications
                    </a>
                </li>

                <li>
                    <a href="/user_dashboard/interviews">
                        <i class="fa-solid fa-calendar-days"></i>
                        Interviews
                    </a>
                </li>

                <li>
                    <a href="/user_dashboard/settings">
                        <i class="fa-solid fa-gear"></i>
                        Settings
                    </a>
                </li>

                <li>
                    <a href="/">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Logout
                    </a>
                </li>

            </ul>

        </aside>

        <!-- ================= MAIN CONTENT ================= -->
        <main class="main-content">

            <section class="jobs-list-section">

                <!-- Filter Bar -->
                <div class="filter-bar">

                    <input
                        type="text"
                        placeholder="Filter title or keyword...">

                    <select>
                        <option value="">All Locations</option>
                        <option>Bengaluru</option>
                        <option>Hyderabad</option>
                        <option>Pune</option>
                        <option>Remote</option>
                    </select>

                    <select>
                        <option value="">All Types</option>
                        <option>Full-Time</option>
                        <option>Part-Time</option>
                        <option>Contract</option>
                        <option>Internship</option>
                    </select>

                </div>

                <!-- Job Cards -->
                <div class="job-cards-grid">

                    <% if (jobs.length===0) { %>

                        <div class="job-card">

                            <h2>No Jobs Available</h2>

                            <p>
                                Recruiters haven't posted any jobs yet.
                            </p>

                        </div>

                    <% } else { %>

                        <% jobs.forEach(job=> { %>

                            <div class="job-card">

                                <div class="job-header">

                                    <div>

                                        <h3>
                                            <%= job.title %>
                                        </h3>

                                        <span class="company-name">
                                            <%= job.company %>
                                        </span>

                                    </div>

                                </div>

                                <p class="job-meta">

                                    <i class="fa-solid fa-location-dot"></i>

                                    <%= job.location %>

                                        &nbsp; | &nbsp;

                                        <i class="fa-solid fa-briefcase"></i>

                                        <%= job.jobType %>

                                </p>

                                <p class="job-meta">

                                    <i class="fa-solid fa-user-tie"></i>

                                    Experience :
                                    <%= job.experience %>

                                </p>

                                <p class="job-meta">

                                    <i class="fa-solid fa-indian-rupee-sign"></i>

                                    Salary :
                                    <%= job.salary %>

                                </p>

                                <p class="job-desc">

                                    <%= job.description %>

                                </p>

                                <p>

                                    <strong>Skills :</strong>

                                    <%= job.skills %>

                                </p>

                                <div class="job-footer">

                                    <button class="btn-primary">

                                        Apply Now

                                    </button>

                                    <button class="btn-icon">

                                        <i class="fa-regular fa-bookmark"></i>

                                    </button>

                                </div>

                            </div>

                        <% }) %>

                    <% } %>

                </div>

            </section>

        </main>

    </div>

</body>

</html>