<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Applicants | HireAI</title>
    <link rel="stylesheet" href="/css/recruiter_dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

<div class="container">

    <!-- Sidebar -->
    <aside class="sidebar">
        <h2>HireAI</h2>
        <ul>
            <li>
                <a href="/recruiter_dashboard">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/post_job">
                    <i class="fa-solid fa-plus"></i>
                    Post Job
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/manage_jobs">
                    <i class="fa-solid fa-briefcase"></i>
                    Manage Jobs
                </a>
            </li>
            <li class="active">
                <a href="/recruiter_dashboard/view_applicants">
                    <i class="fa-solid fa-users"></i>
                    Applicants
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/interview_schedule">
                    <i class="fa-solid fa-calendar-days"></i>
                    Interviews
                </a>
            </li>
            <li>
                <a href="/recruiter_dashboard/company_profile">
                    <i class="fa-solid fa-building"></i>
                    Company
                </a>
            </li>
            <li>
                <a href="/">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <!-- Navbar -->
        <header class="navbar">
            <h1>Candidate Applications</h1>
            <div class="profile">
                <img src="https://i.pravatar.cc/50" alt="Profile">
                <span>Recruiter</span>
            </div>
        </header>

        <!-- Applicants Table Section -->
        <section class="table-section">
            <div class="filter-bar">
                <input type="text" placeholder="Search by name or role...">
                <select>
                    <option value="">All Roles</option>
                    <option value="mern">MERN Developer</option>
                    <option value="frontend">Frontend Developer</option>
                    <option value="java">Java Developer</option>
                </select>
                <select>
                    <option value="">All Statuses</option>
                    <option value="applied">Applied</option>
                    <option value="shortlisted">Shortlisted</option>
                    <option value="interview">Interview</option>
                    <option value="rejected">Rejected</option>
                </select>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Candidate Name</th>
                        <th>Applied Role</th>
                        <th>Experience</th>
                        <th>Resume</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Rahul Sharma</td>
                        <td>MERN Developer</td>
                        <td>2 Years</td>
                        <td><a href="#" class="link-btn"><i class="fa-solid fa-file-pdf"></i> View PDF</a></td>
                        <td><span class="badge applied">Applied</span></td>
                        <td>
                            <select class="status-select">
                                <option value="applied" selected>Applied</option>
                                <option value="shortlist">Shortlist</option>
                                <option value="reject">Reject</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>Priya Patil</td>
                        <td>Frontend Developer</td>
                        <td>1 Year</td>
                        <td><a href="#" class="link-btn"><i class="fa-solid fa-file-pdf"></i> View PDF</a></td>
                        <td><span class="badge interview">Interview</span></td>
                        <td>
                            <select class="status-select">
                                <option value="interview" selected>Interview</option>
                                <option value="shortlist">Shortlist</option>
                                <option value="reject">Reject</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>Aman Verma</td>
                        <td>Java Developer</td>
                        <td>3 Years</td>
                        <td><a href="#" class="link-btn"><i class="fa-solid fa-file-pdf"></i> View PDF</a></td>
                        <td><span class="badge shortlisted">Shortlisted</span></td>
                        <td>
                            <select class="status-select">
                                <option value="shortlisted" selected>Shortlisted</option>
                                <option value="interview">Schedule Interview</option>
                                <option value="reject">Reject</option>
                            </select>
                        </td>
                    </tr>
                </tbody>
            </table>
        </section>

    </main>

</div>

</body>
</html>